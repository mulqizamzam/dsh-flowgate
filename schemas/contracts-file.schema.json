{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flowgate/contracts-file",
  "title": "Flowgate contracts file",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_version",
    "vocabulary",
    "evidence_types",
    "provenance_kinds",
    "check_types",
    "side_effect_classes",
    "retry_policies",
    "contracts"
  ],
  "definitions": {
    "stringArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "properties": {
    "schema_version": { "const": 2 },
    "contract_version": { "const": 2 },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "categories", "risk_levels"],
      "properties": {
        "artifacts": { "$ref": "#/definitions/stringArray" },
        "categories": { "$ref": "#/definitions/stringArray" },
        "risk_levels": { "$ref": "#/definitions/stringArray" }
      }
    },
    "evidence_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["operator_input", "artifact_inspection", "command_execution", "test_execution", "review_result", "declared_evidence"]
      }
    },
    "provenance_kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["operator_input", "observed_command", "observed_tool", "agent_statement"] }
    },
    "check_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["artifact_fields", "artifact_schema", "evidence_block", "evidence_validation", "evidence_current"]
      }
    },
    "side_effect_classes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["read_only", "local_write", "external_mutation"] }
    },
    "retry_policies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["safe_idempotent", "manual_approval_required", "not_retryable"] }
    },
    "contracts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "object" }
    }
  }
}
