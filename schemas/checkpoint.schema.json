{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flowgate/checkpoint",
  "title": "Flowgate checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "schema_version",
    "run_id",
    "engine_version",
    "workflow",
    "created_at",
    "stages",
    "artifacts",
    "evidence",
    "gates",
    "pending_stages",
    "side_effects",
    "dependencies_digest",
    "checksum"
  ],
  "definitions": {
    "stageState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "skill", "state", "attempt_id"],
      "properties": {
        "position": { "type": "integer", "minimum": 1 },
        "skill": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["pending", "ready", "running", "validating", "passed", "failed", "blocked", "error", "cancelled"]
        },
        "attempt_id": { "type": ["string", "null"] }
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_type", "digest", "status"],
      "properties": {
        "artifact_id": { "type": "string", "minLength": 1 },
        "artifact_type": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "enum": ["missing", "present", "valid", "invalid"] }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "status", "digest"],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["missing", "current", "stale", "needs_revalidation", "invalid"] },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "sideEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "class", "retry_policy", "outcome_known"],
      "properties": {
        "stage": { "type": "string", "minLength": 1 },
        "class": { "enum": ["read_only", "local_write", "external_mutation"] },
        "retry_policy": { "enum": ["safe_idempotent", "manual_approval_required", "not_retryable"] },
        "outcome_known": { "type": "boolean" }
      }
    }
  },
  "properties": {
    "checkpoint_id": { "type": "string", "pattern": "^cp-[a-z0-9-]+$" },
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "engine_version": { "type": "string", "minLength": 1 },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "contract_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "integer", "minimum": 1 }
      }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "stages": { "type": "array", "items": { "$ref": "#/definitions/stageState" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/definitions/artifactRef" } },
    "evidence": { "type": "array", "items": { "$ref": "#/definitions/evidenceRef" } },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "status"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "passed", "failed", "blocked", "error"] }
        }
      }
    },
    "pending_stages": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "side_effects": { "type": "array", "items": { "$ref": "#/definitions/sideEffect" } },
    "dependencies_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
