{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flowgate/run-state",
  "title": "Flowgate persisted run state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "engine_version",
    "run_id",
    "session_id",
    "created_at",
    "updated_at",
    "request",
    "routing",
    "workflow",
    "enforcement",
    "status",
    "stages",
    "artifacts",
    "evidence",
    "approvals",
    "observations",
    "gates",
    "review",
    "checkpoints",
    "invalidations",
    "errors",
    "completion"
  ],
  "definitions": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "validationError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "message"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "validationCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ok"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "ok": {
          "type": "boolean"
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "errorRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "at"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "remediation": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gateReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "status",
        "detail"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "artifact_fields",
            "artifact_schema",
            "evidence_block",
            "evidence_validation",
            "evidence_current"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "error"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "state",
        "started_at",
        "ended_at",
        "artifact_ids",
        "evidence_ids",
        "checks",
        "gate",
        "reason"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "pending",
            "ready",
            "running",
            "validating",
            "passed",
            "failed",
            "blocked",
            "error",
            "cancelled"
          ]
        },
        "started_at": {
          "type": "string",
          "minLength": 1
        },
        "ended_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/check"
          }
        },
        "gate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reasons"
          ],
          "properties": {
            "status": {
              "enum": [
                "pending",
                "passed",
                "failed",
                "blocked",
                "error"
              ]
            },
            "reasons": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/gateReason"
              }
            }
          }
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "skill",
        "artifact",
        "required",
        "contract_version",
        "attempts"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/attempt"
          }
        }
      }
    },
    "gateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage",
        "status",
        "reasons",
        "checked_at"
      ],
      "properties": {
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked",
            "error"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/gateReason"
          }
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "schema_version",
        "producer",
        "status",
        "freshness",
        "digest",
        "content",
        "content_bytes",
        "inputs",
        "validation",
        "evidence_ids",
        "created_at",
        "validated_at"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^art-[a-z0-9-]+$"
        },
        "artifact_type": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "const": 1
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "attempt_id"
          ],
          "properties": {
            "stage": {
              "type": "string",
              "minLength": 1
            },
            "attempt_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "status": {
          "enum": [
            "missing",
            "present",
            "valid",
            "invalid"
          ]
        },
        "freshness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "current",
                "needs_revalidation"
              ]
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "digest": {
          "$ref": "#/definitions/digest"
        },
        "content": {
          "type": "string",
          "maxLength": 65536
        },
        "content_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/binding"
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "checks",
            "errors"
          ],
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/validationCheck"
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/validationError"
              }
            }
          }
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "validated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "contract_evidence_id",
        "evidence_type",
        "supports",
        "provenance",
        "observed",
        "binds_to",
        "validation",
        "status",
        "freshness_reason",
        "producer",
        "created_at"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "pattern": "^ev-[a-z0-9-]+$"
        },
        "contract_evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "evidence_type": {
          "enum": [
            "operator_input",
            "artifact_inspection",
            "command_execution",
            "test_execution",
            "review_result",
            "declared_evidence"
          ]
        },
        "supports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "observation_id",
            "command"
          ],
          "properties": {
            "kind": {
              "enum": [
                "operator_input",
                "observed_command",
                "observed_tool",
                "agent_statement"
              ]
            },
            "observation_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "command": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "observed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "excerpt"
          ],
          "properties": {
            "result": {
              "enum": [
                "pass",
                "fail",
                "none",
                "declared"
              ]
            },
            "excerpt": {
              "type": "string",
              "maxLength": 2048
            }
          }
        },
        "binds_to": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/binding"
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "ok",
            "errors"
          ],
          "properties": {
            "method": {
              "enum": [
                "structural",
                "observed_command_match",
                "operator_input"
              ]
            },
            "ok": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/validationError"
              }
            }
          }
        },
        "status": {
          "enum": [
            "missing",
            "current",
            "stale",
            "needs_revalidation",
            "invalid"
          ]
        },
        "freshness_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stage",
            "attempt_id"
          ],
          "properties": {
            "stage": {
              "type": "string",
              "minLength": 1
            },
            "attempt_id": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "kind",
        "command",
        "exit_code",
        "is_error",
        "excerpt",
        "at"
      ],
      "properties": {
        "observation_id": {
          "type": "string",
          "pattern": "^obs-[a-z0-9-]+$"
        },
        "kind": {
          "const": "tool_result"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "is_error": {
          "type": "boolean"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 2048
        },
        "at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "changed",
        "fingerprint_changed",
        "policy",
        "affected",
        "reason",
        "at"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^inv-[a-z0-9-]+$"
        },
        "changed": {
          "type": "string",
          "minLength": 1
        },
        "fingerprint_changed": {
          "type": "boolean"
        },
        "policy": {
          "enum": [
            "invalidate",
            "stale",
            "revalidate",
            "retain"
          ]
        },
        "affected": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_id",
        "schema_version",
        "run_id",
        "engine_version",
        "workflow",
        "created_at",
        "stages",
        "artifacts",
        "evidence",
        "gates",
        "pending_stages",
        "side_effects",
        "dependencies_digest",
        "checksum"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "pattern": "^cp-[a-z0-9-]+$"
        },
        "schema_version": {
          "const": 2
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "engine_version": {
          "type": "string",
          "minLength": 1
        },
        "workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "contract_version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "contract_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "position",
              "skill",
              "state",
              "attempt_id"
            ],
            "properties": {
              "position": {
                "type": "integer",
                "minimum": 1
              },
              "skill": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "pending",
                  "ready",
                  "running",
                  "validating",
                  "passed",
                  "failed",
                  "blocked",
                  "error",
                  "cancelled"
                ]
              },
              "attempt_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "artifact_type",
              "digest",
              "status"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "artifact_type": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "$ref": "#/definitions/digest"
              },
              "status": {
                "enum": [
                  "missing",
                  "present",
                  "valid",
                  "invalid"
                ]
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "status",
              "digest"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "missing",
                  "current",
                  "stale",
                  "needs_revalidation",
                  "invalid"
                ]
              },
              "digest": {
                "$ref": "#/definitions/digest"
              }
            }
          }
        },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "status"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pending",
                  "passed",
                  "failed",
                  "blocked",
                  "error"
                ]
              }
            }
          }
        },
        "pending_stages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "side_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stage",
              "class",
              "retry_policy",
              "outcome_known"
            ],
            "properties": {
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "enum": [
                  "read_only",
                  "local_write",
                  "external_mutation"
                ]
              },
              "retry_policy": {
                "enum": [
                  "safe_idempotent",
                  "manual_approval_required",
                  "not_retryable"
                ]
              },
              "outcome_known": {
                "type": "boolean"
              }
            }
          }
        },
        "dependencies_digest": {
          "$ref": "#/definitions/digest"
        },
        "checksum": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_id",
        "stage",
        "granted_at",
        "kind"
      ],
      "properties": {
        "approval_id": {
          "type": "string",
          "pattern": "^ap-[a-z0-9-]+$"
        },
        "stage": {
          "type": "string",
          "minLength": 1
        },
        "granted_at": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "retry"
          ]
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": 2
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "digest",
        "excerpt"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        },
        "digest": {
          "$ref": "#/definitions/digest"
        },
        "excerpt": {
          "type": "string",
          "maxLength": 280
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scores",
        "selected",
        "reason",
        "fallback"
      ],
      "properties": {
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "workflow",
              "score",
              "priority",
              "selected"
            ],
            "properties": {
              "workflow": {
                "type": "string",
                "minLength": 1
              },
              "score": {
                "type": "integer",
                "minimum": 0
              },
              "priority": {
                "type": "integer"
              },
              "selected": {
                "type": "boolean"
              }
            }
          }
        },
        "selected": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "boolean"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "contract_version",
        "stage_count"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1
        },
        "stage_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "pre_step",
        "limitations"
      ],
      "properties": {
        "level": {
          "enum": [
            "declared",
            "validated",
            "enforced"
          ]
        },
        "pre_step": {
          "enum": [
            "not_used",
            "available_not_used",
            "enforced"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "status": {
      "enum": [
        "created",
        "planned",
        "running",
        "paused",
        "completed",
        "failed",
        "blocked",
