{
  "name": "dsh-flowgate",
  "version": "2.0.0",
  "description": "Evidence-driven, stateful engineering workflows for DeepSeek Harness: 10 skills, 5 workflows, 11 commands, versioned contracts, and dependency-aware invalidation.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "evidence-gating",
    "engineering-workflow"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "schemas",
    "docs",
    "!docs/archive",
    "cordis.patch.yml",
    "LICENSE",
    "PRD.md",
    "README.md",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node scripts/run-gates.mjs",
    "test:gate": "node scripts/run-gates.mjs --only",
    "verify:live": "bash scripts/verify-live.sh"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.0-rc.2",
    "yaml": "^2.4.2"
  }
}
